# Build output. `npm run build` regenerates both; `npm run clean` removes them.
/target
/pkg
/react
/vue

/node_modules
/tests/my-app/node_modules
/tests/my-app/.next
/tests/my-app/package-lock.json

# Local tarballs from `npm pack`.
*.tgz

# Fuzzing. The seed corpus is generated by `examples/fuzz_seeds.rs`, and the
# corpus libFuzzer grows from it is machine-specific and large. A crash found
# here should become a unit test, not a committed artifact.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage
/fuzz/Cargo.lock

# Local editor / agent config, and the registry file that carries a token.
/.claude
.npmrc.github

.DS_Store
