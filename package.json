{
  "name": "@wirunrom/hqr-generate",
  "version": "0.6.0",
  "description": "High-performance QR code generator and decoder powered by Rust + WASM",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wirunrom/hqr-generate.git"
  },
  "homepage": "https://github.com/wirunrom/hqr-generate#readme",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "pkg/**",
    "internal/**",
    "index.node.js",
    "index.web.js",
    "index.d.ts",
    "index.web.d.ts",
    "index.node.d.ts",
    "payload.js",
    "payload.d.ts",
    "scanner.js",
    "scanner.d.ts",
    "react/**",
    "vue/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "types": "./index.d.ts",
  "main": "./index.node.js",
  "module": "./index.web.js",
  "browser": "./index.web.js",
  "sideEffects": [
    "./pkg/**"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./index.d.ts",
        "default": "./index.web.js"
      },
      "node": {
        "types": "./index.node.d.ts",
        "default": "./index.node.js"
      },
      "types": "./index.d.ts",
      "default": "./index.web.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "default": "./vue/index.js"
    },
    "./payload": {
      "types": "./payload.d.ts",
      "default": "./payload.js"
    },
    "./scanner": {
      "types": "./scanner.d.ts",
      "default": "./scanner.js"
    },
    "./web": {
      "types": "./index.d.ts",
      "default": "./index.web.js"
    },
    "./node": {
      "types": "./index.node.d.ts",
      "default": "./index.node.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rm -rf pkg react vue",
    "build:wasm:web": "wasm-pack build --target web --out-dir pkg/web -- --no-default-features --features wasm,generate,barcode",
    "build:wasm:web-decode": "wasm-pack build --target web --out-dir pkg/web-decode -- --no-default-features --features wasm,decode",
    "build:wasm:node": "wasm-pack build --target nodejs --out-dir pkg/nodejs -- --no-default-features --features wasm,generate,barcode",
    "build:wasm:node-decode": "wasm-pack build --target nodejs --out-dir pkg/nodejs-decode -- --no-default-features --features wasm,decode",
    "build:wasm": "npm run build:wasm:web && npm run build:wasm:web-decode && npm run build:wasm:node && npm run build:wasm:node-decode && node scripts/finalize-pkg.mjs",
    "build:react": "tsc -p tsconfig.react.json",
    "build:vue": "tsc -p tsconfig.vue.json",
    "build": "npm run build:wasm && npm run build:react && npm run build:vue",
    "test:rust": "cargo test --features decode,barcode",
    "test:node": "node --test tests/node/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test": "npm run test:rust && npm run test:node",
    "lint": "cargo fmt --all -- --check && cargo clippy --features decode,barcode --all-targets -- -D warnings",
    "bench": "cargo bench --bench generate",
    "fuzz:seeds": "cargo run --release --features decode --example fuzz_seeds",
    "fuzz": "npm run fuzz:seeds && cargo +nightly fuzz run decode_bytes -- -max_total_time=300 -max_len=65536",
    "size": "node scripts/size-report.mjs",
    "prepack": "npm run clean && npm run build && npm run test:node",
    "publish:test": "npm publish --tag next --registry=https://registry.npmjs.org --access public",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org --access public",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com --userconfig .npmrc.github --access public",
    "version:next": "npm version prerelease --preid=next -m \"chore: %s\""
  },
  "keywords": [
    "qrcode",
    "qr",
    "qr-decode",
    "rust",
    "wasm",
    "webassembly",
    "react",
    "nextjs",
    "ssr",
    "browser",
    "vanilla-js",
    "png",
    "svg",
    "uint8array",
    "binary",
    "blob",
    "performance",
    "scan-reliability"
  ],
  "devDependencies": {
    "@types/react": "^19.2.9",
    "playwright": "^1.62.1",
    "react": "^19.2.4",
    "typescript": "^5.9.3",
    "vue": "^3.5.41"
  }
}
